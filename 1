            // --- GROUP 6: WANKO ---
            wanko: [
                { text: "Q9 (ワンコ). 彼の「ワンコのような可愛さ」はどこ？", options: [{ text: "「ほいほい！」と跳びはねて喜ぶアクロバティックさ", chara: "kikumaru" }, { text: "「天才的だろ？」とガムを膨らませて自慢する顔", chara: "bunta" }, { text: "「ワイと遊ぼう！」と全身でぶつかってくる天真爛漫さ", chara: "kintaro" }, { text: "「ねむーい」と膝枕をねだってくる無邪気さ", chara: "johji" }] },
                { text: "Q10 (ワンコ). 彼の甘え方、どれが一番好き？", options: [{ text: "後ろから抱きついて「ねぇねぇ遊ぼうよ〜！」", chara: "kikumaru" }, { text: "「一口ちょうだい！」とおねだりして笑顔になる", chara: "bunta" }, { text: "手を繋いで「あっち行こう！早く早く！」と引っ張る", chara: "kintaro" }, { text: "あなたの膝の上に頭を乗せてすやすや眠る", chara: "johji" }] },
                { text: "Q11 (ワンコ). 彼と一緒に食べに行くなら？", options: [{ text: "オムライスにケチャップでハートを描いて食べる", chara: "kikumaru" }, { text: "新作のホールケーキを半分こして食べる", chara: "bunta" }, { text: "たこ焼きを何十個も焼いてパーティー！", chara: "kintaro" }, { text: "羊羹や甘味処でほっこりおやつタイム", chara: "johji" }] },
                { text: "Q12 (ワンコ). 彼の口癖、どれが一番可愛い？", options: [{ text: "「〜だにゃ！」「充電完了！」", chara: "kikumaru" }, { text: "「シクヨロ！」「天才的だろ？」", chara: "bunta" }, { text: "「めっちゃすごいがや！」「ワイが一番や！」", chara: "kintaro" }, { text: "「うひょー！すっげー！マシマジ！？」", chara: "johji" }] },
                { text: "Q13 (ワンコ). 彼の元気がなさそうな時、どうしてあげる？", options: [{ text: "ギューッと抱きしめて「充填完了！」にしてあげる", chara: "kikumaru" }, { text: "とっておきの甘いチョコレートを口に入れてあげる", chara: "bunta" }, { text: "頭を撫で回して「金ちゃんすごいよ！」と褒める", chara: "kintaro" }, { text: "一緒に横になって手を繋いで寝てあげる", chara: "johji" }] },
                { text: "Q14 (ワンコ). 彼とテーマパークに行ったら？", options: [{ text: "猫耳のカチューシャをお揃いでつけてはしゃぐ", chara: "kikumaru" }, { text: "限定スイーツの屋台を全部制覇する", chara: "bunta" }, { text: "一番激しいジェットコースターに何回も乗る", chara: "kintaro" }, { text: "観覧車の中でうとうと眠る彼を眺める", chara: "johji" }] },
                { text: "Q15 (ワンコ). 彼が見せるかっこいい瞬間のギャップは？", options: [{ text: "菊丸ビームでコートを縦横無尽に舞う姿", chara: "kikumaru" }, { text: "ワンダーキャッスルで完璧な守備を見せる姿", chara: "bunta" }, { text: "超ウルトラグレートデリシャス大車輪山嵐を繰り出す姿", chara: "kintaro" }, { text: "憧れの選手を前にして目が輝いて超絶プレイをする姿", chara: "johji" }] },
                { text: "Q16 (ワンコ). あなたから彼に伝えたい愛の言葉は？", options: [{ text: "「世界で一番かわいくてかっこいいよ、英二くん！」", chara: "kikumaru" }, { text: "「ブン太くんのプレイも優しさも、マジで天才的！」", chara: "bunta" }, { text: "「金ちゃんの無邪気な笑顔が一番大好きだよ！」", chara: "kintaro" }, { text: "「ジローくんの楽しそうなテニス、見てて幸せになれるよ！」", chara: "johji" }] }
            ],

            // --- GROUP 7: ENTAME ---
            entame: [
                { text: "Q9 (エンタメ). 彼の「強烈な個性」のどれに惹かれる？", options: [{ text: "「ロックオン！」と情熱的に愛をぶつけてくる爆発力", chara: "koharu" }, { text: "ものまねと爆笑ツッコミで毎日を飽きさせないエンタメ力", chara: "yuji" }, { text: "四天宝寺のボケに冷静にツッコむクールな毒舌さ", chara: "zaizen" }, { text: "野性味あふれる凶暴さと不器用すぎる優しさの極み", chara: "akutsu" }] },
                { text: "Q10 (エンタメ). 彼とのデート、どんなハプニングが起きそう？", options: [{ text: "彼がド派手な衣装で現れて周りの視線を独占！", chara: "koharu" }, { text: "他校のキャラのものまねをして爆笑させてくれる", chara: "yuji" }, { text: "「また先輩らがアホなこと言っとるわ」とスマホをいじる", chara: "zaizen" }, { text: "カツアゲを返り討ちにして「チッ、行くぞ」と連れ出す", chara: "akutsu" }] },
                { text: "Q11 (エンタme). 彼の愛情表現、どれが一番グッとくる？", options: [{ text: "「小春のハートはあなたのものよ♡」とハートマーク", chara: "koharu" }, { text: "「お前の笑顔は誰にも見せへん！」と嫉妬しちゃう", chara: "yuji" }, { text: "「別に……嫌いじゃないですけど」と小声で呟く", chara: "zaizen" }, { text: "「俺の女に手ぇ出してんじゃねえ」と力強く引き寄せる", chara: "akutsu" }] },
                { text: "Q12 (エンタメ). 彼と一緒に挑戦したいことは？", options: [{ text: "お揃いのド派手な衣装でダンス動画を撮影", chara: "koharu" }, { text: "ふたりで漫才コンビを組んでお笑いグランプリに出場", chara: "yuji" }, { text: "最新のSNS映えスポットで写真を撮り合う", chara: "zaizen" }, { text: "バイクのタンデムシートに乗って夜の街をドライブ", chara: "akutsu" }] },
                { text: "Q13 (エンタメ). 彼のギャップ萌えポイントは？", options: [{ text: "乙女系なのに IQ200の超データテニスプレイヤーなところ", chara: "koharu" }, { text: "お調子者なのに好きな人の前では独占欲が強いところ", chara: "yuji" }, { text: "冷めてるフリして部活の動画をブログにアップする熱さ", chara: "zaizen" }, { text: "凶悪に見えて母親想いでモンブランが大好きなところ", chara: "akutsu" }] },
                { text: "Q14 (エンタメ). 彼のプレゼントの選び方は？", options: [{ text: "開けた瞬間に紙吹雪が飛び出すサプライズボックス", chara: "koharu" }, { text: "「これでお揃いや！」と爆笑必至の面白ペアグッズ", chara: "yuji" }, { text: "「これ、流行ってるらしいっすよ」とさり気なくくれる", chara: "zaizen" }, { text: "「……やる」と投げ渡してくる大好物の高級スイーツ", chara: "akutsu" }] },
                { text: "Q15 (エンタメ). ケンカした時の彼の態度は？", options: [{ text: "「キーッ！もう小春絶交よ！」と可愛くぷんぷん怒る", chara: "koharu" }, { text: "「なぁなぁ、悪かったって！笑ってや〜！」と顔芸で笑わせる", chara: "yuji" }, { text: "「……ハァ、ほんま手がかかりますね」と溜息つきつつ折れる", chara: "zaizen" }, { text: "「あぁ！？文句あんのか！……怪我ねえな？」と心配する", chara: "akutsu" }] },
                { text: "Q16 (エンタメ). あなたにとっての彼はどんな存在？", options: [{ text: "人生をキラキラ輝かせてくれる最高の乙女フレンド＆彼氏", chara: "koharu" }, { text: "笑いが絶えない最高の相方であり愛しい彼氏", chara: "yuji" }, { text: "クールだけど頼りになる、一番キュンとする後輩彼氏", chara: "zaizen" }, { text: "自分だけが知っている優しさを守りたくなる男気彼氏", chara: "akutsu" }] }
            ]
        };

        /* ==========================================================================
           4. APP STATE & CONTROLLER LOGIC
           ========================================================================== */
        let state = {
            userName: "",
            currentStep: 0, // 0 to 15 (Questions 1 to 16)
            phase1Scores: {
                supadari: 0,
                tsundere: 0,
                netsuetsu: 0,
                aniya: 0,
                mypace: 0,
                wanko: 0,
                entame: 0
            },
            determinedGroup: null,
            phase2Scores: {}, // charaId -> score
            history: []
        };

        // --- Start Diagnosis ---
        function startDiagnosis() {
            const nameInput = document.getElementById("username");
            const nameErr = document.getElementById("name-error");
            const val = nameInput.value.trim();

            if (!val) {
                nameErr.classList.remove("hidden");
                nameInput.focus();
                return;
            }
            nameErr.classList.add("hidden");

            state.userName = val;
            state.currentStep = 0;
            state.phase1Scores = { supadari: 0, tsundere: 0, netsuetsu: 0, aniya: 0, mypace: 0, wanko: 0, entame: 0 };
            state.determinedGroup = null;
            state.phase2Scores = {};

            document.getElementById("start-screen").classList.add("hidden");
            document.getElementById("quiz-screen").classList.remove("hidden");

            renderQuestion();
        }

        // --- Render Current Question ---
        function renderQuestion() {
            const totalSteps = 16;
            const qIndex = state.currentStep; // 0..15

            // Progress Update
            const progPercent = ((qIndex + 1) / totalSteps) * 100;
            document.getElementById("progress-bar").style.width = `${progPercent}%`;
            document.getElementById("progress-text").innerText = `Q ${qIndex + 1} / 16`;

            const phaseBadge = document.getElementById("phase-badge");
            const qText = document.getElementById("question-text");
            const optionsContainer = document.getElementById("options-container");
            optionsContainer.innerHTML = "";

            if (qIndex < 8) {
                // PHASE 1
                phaseBadge.innerText = "前半：タイプ判定";
                phaseBadge.className = "px-3 py-1 rounded-full bg-pink-100 text-pink-600 border border-pink-200 font-bold";

                const qData = PHASE1_QUESTIONS[qIndex];
                qText.innerText = qData.text;

                qData.options.forEach((opt) => {
                    const btn = document.createElement("button");
                    btn.className = "option-btn w-full bg-pink-50/80 hover:bg-pink-100 text-gray-800 font-bold py-3.5 px-4 rounded-2xl border-2 border-pink-200/80 text-sm sm:text-base text-left shadow-sm flex items-center justify-between";
                    btn.innerHTML = `<span>${opt.text}</span> <span class="text-pink-400 text-lg">➔</span>`;
                    btn.onclick = () => handlePhase1Answer(opt.group);
                    optionsContainer.appendChild(btn);
                });
            } else {
                // PHASE 2
                phaseBadge.innerText = `後半：${GROUP_TYPES[state.determinedGroup].name.split("・")[0]} 個人絞り込み`;
                phaseBadge.className = "px-3 py-1 rounded-full bg-yellow-100 text-yellow-700 border border-yellow-300 font-bold";

                const groupQuestions = PHASE2_QUESTIONS[state.determinedGroup];
                const p2Index = qIndex - 8;
                const qData = groupQuestions[p2Index];
                qText.innerText = qData.text;

                qData.options.forEach((opt) => {
                    const btn = document.createElement("button");
                    btn.className = "option-btn w-full bg-yellow-50/80 hover:bg-yellow-100 text-gray-800 font-bold py-3.5 px-4 rounded-2xl border-2 border-yellow-200/80 text-sm sm:text-base text-left shadow-sm flex items-center justify-between";
                    btn.innerHTML = `<span>${opt.text}</span> <span class="text-yellow-500 text-lg">✨</span>`;
                    btn.onclick = () => handlePhase2Answer(opt.chara);
                    optionsContainer.appendChild(btn);
                });
            }
        }

        // --- Handle Phase 1 Answer ---
        function handlePhase1Answer(groupKey) {
            state.phase1Scores[groupKey]++;
            state.currentStep++;

            // Transition to Phase 2 after Q8
            if (state.currentStep === 8) {
                determineGroup();
            }

            renderQuestion();
        }

        // --- Determine Winning Group ---
        function determineGroup() {
            let maxScore = -1;
            let winningGroup = "supadari";

            // Find group with highest score
            for (const [group, score] of Object.entries(state.phase1Scores)) {
                if (score > maxScore) {
                    maxScore = score;
                    winningGroup = group;
                }
            }
            state.determinedGroup = winningGroup;

            // Initialize Phase 2 Scores for characters in this group
            state.phase2Scores = {};
            PHASE2_QUESTIONS[winningGroup][0].options.forEach(opt => {
                state.phase2Scores[opt.chara] = 0;
            });
        }

        // --- Handle Phase 2 Answer ---
        function handlePhase2Answer(charaId) {
            if (!state.phase2Scores[charaId]) {
                state.phase2Scores[charaId] = 0;
            }
            state.phase2Scores[charaId]++;
            state.currentStep++;

            if (state.currentStep >= 16) {
                showResults();
            } else {
                renderQuestion();
            }
        }

        // --- Show Results ---
        function showResults() {
            document.getElementById("quiz-screen").classList.add("hidden");
            document.getElementById("result-screen").classList.remove("hidden");

            // Determine winning character from Phase 2 scores
            let maxScore = -1;
            let winningCharaId = null;

            for (const [charaId, score] of Object.entries(state.phase2Scores)) {
                if (score > maxScore) {
                    maxScore = score;
                    winningCharaId = charaId;
                }
            }

            const winner = CHARACTERS[winningCharaId];
            const groupInfo = GROUP_TYPES[state.determinedGroup];

            // Render Result Details
            document.getElementById("result-user-name").innerText = state.userName;
            document.getElementById("result-type-name").innerText = groupInfo.name;
            document.getElementById("result-chara-name").innerText = winner.name;
            document.getElementById("result-school").innerText = winner.school;
            document.getElementById("result-comment").innerText = winner.comment;

            // Add to session history
            state.history.unshift({
                user: state.userName,
                chara: winner.name,
                school: winner.school,
                type: groupInfo.name
            });

            renderHistory();
        }

        // --- Render Diagnosis History ---
        function renderHistory() {
            const listEl = document.getElementById("history-list");
            const emptyEl = document.getElementById("history-empty");

            if (state.history.length === 0) {
                emptyEl.classList.remove("hidden");
                listEl.innerHTML = "";
                return;
            }

            emptyEl.classList.add("hidden");
            listEl.innerHTML = state.history.map((item, idx) => `
                <li class="bg-white p-2.5 rounded-xl border border-pink-100 flex items-center justify-between shadow-sm animate-fade-in">
                    <span class="font-bold text-gray-700">💖 ${item.user} さん</span>
                    <span class="text-pink-600 font-extrabold bg-pink-50 px-2 py-0.5 rounded-md border border-pink-200">${item.chara} (${item.school.split(' ')[0]})</span>
                </li>
            `).join("");
        }

        // --- Restart Diagnosis ---
        function restartDiagnosis() {
            document.getElementById("result-screen").classList.add("hidden");
            document.getElementById("start-screen").classList.remove("hidden");
            document.getElementById("username").value = "";
        }
    </script>
</body>
